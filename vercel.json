{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:prod",
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://namviet-erp-api.onrender.com/api/:path*"
    },
    {
      "source": "/hubs/:path*",
      "destination": "https://namviet-erp-api.onrender.com/hubs/:path*"
    },
    {
      "source": "/health",
      "destination": "https://namviet-erp-api.onrender.com/health"
    },
    {
      "source": "/health/ready",
      "destination": "https://namviet-erp-api.onrender.com/health/ready"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
