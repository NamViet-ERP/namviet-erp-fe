{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://namviet-erp-api.onrender.com/api/:path*"
    },
    {
      "source": "/hubs/:path*",
      "destination": "https://namviet-erp-api.onrender.com/hubs/:path*"
    },
    {
      "source": "/health",
      "destination": "https://namviet-erp-api.onrender.com/health"
    },
    {
      "source": "/health/ready",
      "destination": "https://namviet-erp-api.onrender.com/health/ready"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
