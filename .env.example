# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` (local dev) and `.env.production` (build).
# Only variables prefixed with VITE_ are exposed to the client bundle.
# Do NOT put secrets here — everything VITE_* ends up in the browser.
# ─────────────────────────────────────────────────────────────

# Base URL of the C# .NET Core API. Leave empty while using mock data.
VITE_API_BASE_URL=

# 'true'  -> serve bundled mock data (no backend required)
# 'false' -> call the real API at VITE_API_BASE_URL
VITE_USE_MOCK=true

# Public base path. Use '/' for root hosting, or '/wms/' for a sub-path.
VITE_BASE_PATH=/
