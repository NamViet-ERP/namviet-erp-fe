# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` (local dev) and `.env.production` (build).
# Only variables prefixed with VITE_ are exposed to the client bundle.
# Do NOT put secrets here — everything VITE_* ends up in the browser.
# ─────────────────────────────────────────────────────────────

# API base URL. Leave EMPTY for same-origin (Vite/dev proxy or prod reverse proxy).
# Auth cookies require same-origin; do not point this at a different host in cookie mode.
VITE_API_BASE_URL=

# Dev/preview proxy target when VITE_API_BASE_URL is empty (not exposed to the browser).
VITE_DEV_PROXY_TARGET=http://localhost:8080

# Public base path. Use '/' for root hosting, or '/wms/' for a sub-path.
VITE_BASE_PATH=/

# Playwright E2E — E2E_USERNAME and E2E_PASSWORD are required (no defaults in code).
# E2E_API_URL=http://localhost:8080
# PLAYWRIGHT_BASE_URL=http://localhost:5173
# E2E_USERNAME=
# E2E_PASSWORD=
