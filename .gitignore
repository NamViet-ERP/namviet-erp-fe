# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local credentials scratch file (never commit)
.tmp-login.json
.tmp-*.json
.tmp-*.txt

.agents/

.claude/
.sixth/

# Local env (use .env.example)
.env
.env.production
.env.test

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
e2e/.auth/

# Local scratch under docs/ — only DEPLOY.md is tracked
docs/*
!docs/DEPLOY.md

# Build scripts for production (verify + build-prod)
scripts/*
!scripts/verify-prod-env.mjs
!scripts/verify-no-mock-src.mjs
!scripts/verify-prod-bundle.mjs
!scripts/build-prod.mjs
