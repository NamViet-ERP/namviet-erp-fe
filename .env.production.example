# Copy to `.env.production` on the machine that runs `npm run build:prod`.
# Same-origin cookie auth: leave VITE_API_BASE_URL empty and terminate TLS
# + reverse-proxy /api (and /hubs) to the API on the same host as the SPA.
#
# Only set an absolute URL if the API is same-site via your gateway and you
# intentionally call it by absolute URL (prefer empty + proxy).

VITE_API_BASE_URL=
VITE_BASE_PATH=/
